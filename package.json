{
  "name": "llm-gateway-proxy",
  "version": "1.0.0",
  "description": "Standalone Multi-Protocol LLM Proxy Gateway for Google Cloud Code / Antigravity",
  "license": "MIT",
  "author": "HoaiNam",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hoainambeco/llm-gateway-proxy.git"
  },
  "main": "dist/main.js",
  "scripts": {
    "build": "nest build",
    "web:dev": "npm --prefix web run dev",
    "web:build": "npm --prefix web run build",
    "build:all": "npm run web:build && npm run build",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/main",
    "add-account": "tsx src/cli/add-account.ts",
    "api-key": "tsx src/cli/api-key.ts",
    "typeorm": "ts-node -r tsconfig-paths/register -r dotenv/config ./node_modules/typeorm/cli -d src/modules/database/data-source.ts",
    "migration:generate": "npm run typeorm -- migration:generate",
    "migration:create": "npm run typeorm -- migration:create",
    "migration:run": "npm run typeorm -- migration:run",
    "migration:run:prod": "node ./node_modules/typeorm/cli.js -d dist/modules/database/data-source.js migration:run",
    "migration:revert": "npm run typeorm -- migration:revert",
    "type-check": "tsc --noEmit",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix"
  },
  "dependencies": {
    "@fastify/multipart": "^9.4.0",
    "@fastify/static": "^10.1.5",
    "@nestjs/common": "^11.1.18",
    "@nestjs/core": "^11.1.18",
    "@nestjs/graphql": "^13.4.5",
    "@nestjs/mercurius": "^13.4.5",
    "@nestjs/platform-fastify": "^11.1.18",
    "@nestjs/typeorm": "^11.0.0",
    "@types/better-sqlite3": "^9.6.0",
    "axios": "^1.8.1",
    "better-sqlite3": "^12.11.1",
    "dotenv": "^16.4.7",
    "fastify": "^5.12.5",
    "graphql": "^16.14.2",
    "lodash-es": "^4.17.21",
    "mercurius": "^16.12.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "typeorm": "^0.3.31",
    "uuid": "^11.1.0",
    "ws": "^8.18.1",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.24",
    "@nestjs/schematics": "^11.1.0",
    "@types/lodash-es": "^4.17.12",
    "@types/node": "^22.13.4",
    "@types/ws": "^8.5.14",
    "oxlint": "^1.85.0",
    "ts-node": "^10.9.2",
    "tsc-alias": "^1.9.5",
    "tsconfig-paths": "^4.2.0",
    "tsx": "^4.19.3",
    "typescript": "^5.7.3"
  },
  "overrides": {
    "fastify": "$fastify",
    "@graphql-tools/utils": "^12.0.1"
  }
}
